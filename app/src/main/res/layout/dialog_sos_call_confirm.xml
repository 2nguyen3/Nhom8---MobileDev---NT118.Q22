<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bg_home_notification_popup"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/txtSosCallTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/quicksand_bold"
        android:text="Gọi hỗ trợ?"
        android:textColor="#313866"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/txtSosCallMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/quicksand_medium"
        android:lineSpacingExtra="4dp"
        android:text="Heami sẽ mở màn hình gọi điện cho bạn."
        android:textColor="#7D8BB7"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmCall"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/quicksand_bold"
        android:text="Mở màn hình gọi"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="#E86FA0"
        app:cornerRadius="28dp"
        app:elevation="0dp" />

    <TextView
        android:id="@+id/btnCancelCall"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/quicksand_bold"
        android:gravity="center"
        android:text="Để sau"
        android:textColor="#9AA8C7"
        android:textSize="14sp" />

</LinearLayout>