<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_admin_card_soft"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtReportTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Report bài viết • Ẩn danh"
            android:textColor="#1B1730"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtReportStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_active_purple"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="PENDING"
            android:textColor="#6A42C2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtReportReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Lý do: Nội dung nhạy cảm"
        android:textColor="#84788F"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/txtReportSnapshot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="3"
        android:text="Snapshot nội dung bị report"
        android:textColor="#1B1730"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtReportMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Trạng thái: PENDING • 02/07/2026 21:30"
        android:textColor="#9A8FA7"
        android:textSize="12sp" />

</LinearLayout>