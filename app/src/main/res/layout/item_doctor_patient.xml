<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Avatar -->
            <FrameLayout
                android:id="@+id/patientAvatarContainer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_stat_icon_pink"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/patientAvatarEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🦋"
                    android:textSize="20sp"/>
            </FrameLayout>

            <!-- Status Indicator Badge (Mood Dot Overlay) -->
            <View
                android:id="@+id/patientStatusDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/bg_mood_dot_purple"
                app:layout_constraintBottom_toBottomOf="@id/patientAvatarContainer"
                app:layout_constraintEnd_toEndOf="@id/patientAvatarContainer" />

            <!-- Middle Info Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintStart_toEndOf="@id/patientAvatarContainer"
                app:layout_constraintEnd_toStartOf="@id/patientChevron"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Nickname & Tags Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtPatientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tên Bệnh nhân"
                        android:textColor="#2D1B47"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="10dp" />

                    <!-- Mood Chip -->
                    <TextView
                        android:id="@+id/txtPatientMoodTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mood"
                        android:textColor="#C586E8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_purple"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_marginEnd="6dp" />

                    <!-- Has Plan Chip -->
                    <LinearLayout
                        android:id="@+id/layoutPatientPlanTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_tag_teal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_check_circle"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Có kế hoạch"
                            android:textColor="#009688"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Subtitle (Note description) -->
                <TextView
                    android:id="@+id/txtPatientSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Không có ghi chép tình trạng."
                    android:textColor="#7F8C8D"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Chevron Right -->
            <ImageView
                android:id="@+id/patientChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#BDC3C7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="Chevron right" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#F2F4F7"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"/>

        <!-- Footer Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_clock"
                    app:tint="#7F8C8D"
                    android:contentDescription="clock icon"/>

                <TextView
                    android:id="@+id/txtPatientSessionsCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Đã trị liệu: 0 phiên"
                    android:textColor="#7F8C8D"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
