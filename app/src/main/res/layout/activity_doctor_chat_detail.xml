<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutChatToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#95FFFFFF"
        android:paddingStart="16dp"
        android:paddingTop="52dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnChatDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chat_btn_back"
            android:contentDescription="Back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="#1A2530" />

        <FrameLayout
            android:id="@+id/layoutChatDetailAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_stat_icon_blue"
            app:layout_constraintStart_toEndOf="@id/btnChatDetailBack"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txtChatDetailAvatarEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🦋"
                android:textSize="20sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/layoutChatDetailAvatar"
            app:layout_constraintEnd_toStartOf="@id/btnChatDetailCall"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txtChatDetailName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Người dùng Heami"
                android:textColor="#1A2530"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChatDetailSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🟢 Đang tư vấn"
                android:textColor="#09A38C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChatDetailModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Chat tư vấn"
                android:textColor="#7B61FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnChatDetailCall"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chat_btn_call"
            android:contentDescription="Call"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_doctor_call"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="#09A38C" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layoutSessionBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_stat_icon_green"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/layoutChatToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="clock icon"
            android:src="@drawable/ic_timer"
            app:tint="#09A38C" />

        <TextView
            android:id="@+id/txtChatDetailBannerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Phiên tư vấn đang hoạt động"
            android:textColor="#09A38C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtChatDetailEndSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_inactive"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="Kết thúc"
            android:textColor="#09A38C"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatDetailMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSessionBanner"
        app:layout_constraintBottom_toTopOf="@id/layoutChatInputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutChatDetailEmptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSessionBanner"
        app:layout_constraintBottom_toTopOf="@id/layoutChatInputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="💬"
            android:textSize="34sp"
            android:background="@drawable/bg_circle_white_alpha" />

        <TextView
            android:id="@+id/txtChatDetailEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chưa có tin nhắn"
            android:textColor="#20303C"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtChatDetailEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Khi phiên tư vấn bắt đầu, tin nhắn sẽ xuất hiện tại đây."
            android:textColor="#7B8794"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressChatDetail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="#09A38C"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutSessionBanner"
        app:layout_constraintBottom_toTopOf="@id/layoutChatInputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutChatInputBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_search_pill"
        android:elevation="2dp"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/edtChatDetailInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:background="#00000000"
            android:hint="Nhập tin nhắn..."
            android:singleLine="true"
            android:textColor="#1A2530"
            android:textColorHint="#B5BFD1"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnChatDetailSend"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnChatDetailSend"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_chat_btn_back"
            android:contentDescription="Send"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_send_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tint="#B5BFD1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>