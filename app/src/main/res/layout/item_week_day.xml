<?xml version="1.0" encoding="utf-8"?>
<!--
    item_week_day.xml
    Layout cho 1 ngày trong lịch tuần của bác sĩ.
    Gồm:
      - Cột trái: badge ngày (tên thứ + số ngày) + đường timeline
      - Cột phải: card chứa danh sách slot (available / booked)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="4dp">

    <!-- ── Cột trái: timeline ── -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="4dp">

        <!-- Badge ngày -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDayBadge"
            android:layout_width="44dp"
            android:layout_height="52dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0FBF9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#09A38C"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvDayNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A2530"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Đường timeline dọc phía dưới badge -->
        <View
            android:id="@+id/timelineLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#E8F5F3"
            android:layout_marginTop="6dp"
            android:minHeight="16dp" />
    </LinearLayout>

    <!-- ── Cột phải: nội dung slot ── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="12dp">

        <!-- Container slots sẽ được add programmatically -->
        <LinearLayout
            android:id="@+id/containerSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Empty state (ẩn mặc định) -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_legend_dot_available"
                android:alpha="0.4"
                android:layout_gravity="center_vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không có lịch trình"
                android:textColor="#C0CCDD"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
