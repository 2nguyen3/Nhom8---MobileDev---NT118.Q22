<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#103C3B">

    <!-- Decorative blobs -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-60dp"
        android:alpha="0.50"
        android:background="@drawable/bg_blob_doctor_mint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginEnd="-70dp"
        android:layout_marginTop="260dp"
        android:alpha="0.30"
        android:background="@drawable/bg_blob_doctor_pink"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginStart="-55dp"
        android:layout_marginBottom="130dp"
        android:alpha="0.22"
        android:background="@drawable/bg_blob_doctor_mint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Top bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCallTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnCallBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_glass"
            android:contentDescription="Back"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0F4A48" />

        <LinearLayout
            android:id="@+id/layoutCallTimerChip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCallSwitch"
            app:layout_constraintStart_toEndOf="@id/btnCallBack"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_green" />

            <TextView
                android:id="@+id/txtCallTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="00:17"
                android:textColor="#0F4A48"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCallSwitch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_glass"
            android:contentDescription="Switch camera"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_call_switch"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#0F4A48" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Local preview -->
    <FrameLayout
        android:id="@+id/layoutCallLocalPreview"
        android:layout_width="94dp"
        android:layout_height="126dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_dialog_glass"
        android:padding="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCallTopBar">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#16252F">

            <FrameLayout
                android:id="@+id/frameCallLocalVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/txtCallLocalEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🙂"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/txtCallLocalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_dialog_glass"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Bạn"
                android:textColor="#0F4A48"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

    <!-- Main center content -->
    <LinearLayout
        android:id="@+id/layoutCallCenterContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        app:layout_constraintBottom_toTopOf="@id/layoutCallBottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCallTopBar">

        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/bg_circle_white_alpha"
            android:padding="2dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_dialog_glass">

                <FrameLayout
                    android:id="@+id/frameCallRemoteVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/txtCallRemoteEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🩺"
                    android:textSize="58sp" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/txtCallPartnerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="ThS. Trần Thị Lan"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCallPartnerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Chuyên gia Trị liệu Nhận thức"
            android:textColor="#B7D0CD"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dialog_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_dot_green" />

            <TextView
                android:id="@+id/txtCallConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Đã kết nối"
                android:textColor="#0F4A48"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/layoutCallBottomControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="44dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnCallSpeaker"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_dialog_glass"
                    android:contentDescription="Speaker"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_speaker"
                    app:tint="#0F4A48" />

                <TextView
                    android:id="@+id/txtCallSpeakerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Loa"
                    android:textColor="#C6D7D5"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnCallCamera"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_dialog_glass"
                    android:contentDescription="Camera"
                    android:padding="14dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_camera"
                    app:tint="#0F4A48" />

                <TextView
                    android:id="@+id/txtCallCameraLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Camera"
                    android:textColor="#C6D7D5"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnCallMic"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_dialog_glass"
                    android:contentDescription="Mic"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_mic"
                    app:tint="#0F4A48" />

                <TextView
                    android:id="@+id/txtCallMicLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Micro"
                    android:textColor="#C6D7D5"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="92dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnCallEnd"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_call_end_gradient"
                    android:backgroundTint="@null"
                    android:contentDescription="End call"
                    android:padding="20dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_end"
                    app:backgroundTint="@null"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/txtCallEndLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Kết thúc"
                    android:textColor="#F5FFFD"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnCallChat"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_dialog_glass"
                    android:contentDescription="Chat"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_call_chat"
                    app:tint="#0F4A48" />

                <TextView
                    android:id="@+id/txtCallChatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Note"
                    android:textColor="#C6D7D5"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>