<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient">

    <!-- Decor giữ style cũ -->
    <ImageView
        android:id="@+id/decorFlowerPinkTop"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="60dp"
        android:alpha="0.6"
        android:contentDescription="decor pink"
        android:src="@drawable/ic_flower_pink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/decorFlowerMintMid"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginTop="160dp"
        android:layout_marginEnd="30dp"
        android:alpha="0.5"
        android:contentDescription="decor mint"
        android:src="@drawable/ic_flower_mint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header giữ style cũ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutDoctorMessagesHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="52dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUẢN LÝ TIN NHẮN"
                android:textColor="#09A38C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tin nhắn"
                android:textColor="#112233"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Search giữ style cũ -->
    <EditText
        android:id="@+id/edtDoctorMessagesSearch"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_search_pill"
        android:drawableStart="@drawable/ic_doctor_search"
        android:drawablePadding="10dp"
        android:elevation="0dp"
        android:hint="Tìm cuộc trò chuyện..."
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:singleLine="true"
        android:textColor="#2D3A5E"
        android:textColorHint="#B5BFD1"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutDoctorMessagesHeader" />

    <!-- Horizontal Scroll Filter Tabs -->
    <HorizontalScrollView
        android:id="@+id/layoutDoctorMessagesFilters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="22dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtDoctorMessagesSearch">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <!-- Tab Đang tư vấn -->
            <TextView
                android:id="@+id/btnFilterOngoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang tư vấn"
                android:textColor="#009688"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_active_border"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />

            <!-- Tab Sắp tới -->
            <TextView
                android:id="@+id/btnFilterUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sắp tới"
                android:textColor="#7F8C8D"
                android:textSize="13sp"
                android:background="@drawable/bg_chip_inactive_border"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />

            <!-- Tab Hoàn thành -->
            <TextView
                android:id="@+id/btnFilterCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoàn thành"
                android:textColor="#7F8C8D"
                android:textSize="13sp"
                android:background="@drawable/bg_chip_inactive_border"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- RecyclerView mới thay cho card cứng -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDoctorConsultationRooms"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNavDoctorContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutDoctorMessagesFilters" />

    <!-- Empty state mới -->
    <LinearLayout
        android:id="@+id/layoutDoctorMessagesEmptyState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNavDoctorContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutDoctorMessagesFilters">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_white_alpha"
            android:gravity="center"
            android:text="💬"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/txtDoctorMessagesEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chưa có cuộc trò chuyện tư vấn nào"
            android:textColor="#20303C"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDoctorMessagesEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Khi user bắt đầu phiên chat tư vấn,\nđoạn chat sẽ xuất hiện ở đây."
            android:textColor="#7B8794"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Progress mới -->
    <ProgressBar
        android:id="@+id/progressDoctorMessages"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="#7B61FF"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNavDoctorContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutDoctorMessagesFilters" />

    <!-- Bottom nav giữ nguyên -->
    <include
        android:id="@+id/layoutBottomNavDoctorContainer"
        layout="@layout/bottom_nav_doctor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>