<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_doctor_screen">

    <View
        android:id="@+id/blobStatsPink"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.2"
        android:background="@drawable/bg_blob_doctor_pink"
        android:translationX="-36dp"
        android:translationY="-48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/blobStatsMint"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:alpha="0.1"
        android:background="@drawable/bg_blob_doctor_mint"
        android:translationX="36dp"
        android:translationY="470dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="50dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_doctor_detail_round_btn"
            android:contentDescription="Quay lại"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#313866" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtStatsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_medium"
                android:text="Thấu hiểu • Chữa lành • An yên"
                android:textColor="#E8507A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtStatsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hành trình cảm xúc"
                android:textColor="#2D1B47"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnExportReport"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_doctor_detail_round_btn"
            android:contentDescription="Xuất báo cáo"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_download"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#313866" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:focusable="true"
            android:focusableInTouchMode="true">

            <!-- Bộ lọc thời gian phân cấp -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Spinner Năm -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Năm"
                                android:textColor="#7D8BB7"
                                android:textSize="11sp"
                                android:fontFamily="@font/quicksand_bold"
                                android:layout_marginBottom="4dp"/>
                            <Spinner
                                android:id="@+id/spinnerYear"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_spinner" />
                        </LinearLayout>

                        <!-- Spinner Tháng -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:orientation="vertical"
                            android:layout_marginHorizontal="3dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tháng"
                                android:textColor="#7D8BB7"
                                android:textSize="11sp"
                                android:fontFamily="@font/quicksand_bold"
                                android:layout_marginBottom="4dp"/>
                            <Spinner
                                android:id="@+id/spinnerMonth"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_spinner" />
                        </LinearLayout>

                        <!-- Spinner Tuần -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tuần"
                                android:textColor="#7D8BB7"
                                android:textSize="11sp"
                                android:fontFamily="@font/quicksand_bold"
                                android:layout_marginBottom="4dp"/>
                            <Spinner
                                android:id="@+id/spinnerWeek"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_spinner" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/txtCalendarMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Lịch Cảm Xúc Theo Tháng"
                        android:textColor="#313866"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:rowCount="1"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:gravity="center" android:text="T2" android:textColor="#7D8BB7" android:fontFamily="@font/quicksand_bold" android:textSize="11sp"/>
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:gravity="center" android:text="T3" android:textColor="#7D8BB7" android:fontFamily="@font/quicksand_bold" android:textSize="11sp"/>
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:gravity="center" android:text="T4" android:textColor="#7D8BB7" android:fontFamily="@font/quicksand_bold" android:textSize="11sp"/>
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:gravity="center" android:text="T5" android:textColor="#7D8BB7" android:fontFamily="@font/quicksand_bold" android:textSize="11sp"/>
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:gravity="center" android:text="T6" android:textColor="#7D8BB7" android:fontFamily="@font/quicksand_bold" android:textSize="11sp"/>
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:gravity="center" android:text="T7" android:textColor="#7D8BB7" android:fontFamily="@font/quicksand_bold" android:textSize="11sp"/>
                        <TextView android:layout_width="0dp" android:layout_columnWeight="1" android:gravity="center" android:text="CN" android:textColor="#E86FA0" android:fontFamily="@font/quicksand_bold" android:textSize="11sp"/>
                    </GridLayout>

                    <GridLayout
                        android:id="@+id/gridCalendar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="7"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Xu Hướng Theo Tháng"
                        android:textColor="#313866"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="😊 Vui vẻ" android:textColor="#313866" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                            <TextView android:id="@+id/txtPercentHappy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="45%" android:textColor="#00BFA5" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                        </RelativeLayout>
                        <ProgressBar
                            android:id="@+id/progressHappy"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="45"/>
                    </LinearLayout>

                   <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="😌 Bình yên" android:textColor="#313866" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                            <TextView android:id="@+id/txtPercentCalm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="25%" android:textColor="#4A90E2" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                        </RelativeLayout>
                        <ProgressBar
                            android:id="@+id/progressCalm"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="25"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="😮‍💨 Căng thẳng" android:textColor="#313866" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                            <TextView android:id="@+id/txtPercentStressed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="15%" android:textColor="#FFB300" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                        </RelativeLayout>
                        <ProgressBar
                            android:id="@+id/progressStressed"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="15"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="😢 Buồn bã" android:textColor="#313866" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                            <TextView android:id="@+id/txtPercentSad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="10%" android:textColor="#9C27B0" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                        </RelativeLayout>
                        <ProgressBar
                            android:id="@+id/progressSad"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="10"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="😡 Giận dữ" android:textColor="#313866" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                            <TextView android:id="@+id/txtPercentAngry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="5%" android:textColor="#E86FA0" android:fontFamily="@font/quicksand_bold" android:textSize="12sp"/>
                        </RelativeLayout>
                        <ProgressBar
                            android:id="@+id/progressAngry"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:progress="5"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Đa Chiều Cảm Xúc Theo Tháng"
                        android:textColor="#313866"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp" />

                    <com.example.heami.ui.custom.EmotionalRadarChartView
                        android:id="@+id/radarChartView"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Tâm Trạng Theo Tuần"
                        android:textColor="#313866"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp" />

                    <com.example.heami.ui.custom.WeeklyLineChartView
                        android:id="@+id/weeklyLineChart"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Múi Giờ Nhạy Cảm Theo Tuần"
                        android:textColor="#313866"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_medium"
                        android:text="Mức độ áp lực/nhạy cảm theo các khung giờ trong tuần."
                        android:textColor="#7D8BB7"
                        android:textSize="11sp"
                        android:layout_marginBottom="16dp" />

                    <com.example.heami.ui.custom.SensitiveTimezoneHeatmapView
                        android:id="@+id/heatmapView"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />

                    <!-- Chú giải cấp độ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="12dp">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="#F5F6F8" android:layout_marginEnd="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bình yên" android:textSize="10sp" android:textColor="#7D8BB7" android:layout_marginEnd="12dp"/>
                        
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="#B2DFDB" android:layout_marginEnd="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thấp" android:textSize="10sp" android:textColor="#7D8BB7" android:layout_marginEnd="12dp"/>

                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="#4DB6AC" android:layout_marginEnd="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vừa" android:textSize="10sp" android:textColor="#7D8BB7" android:layout_marginEnd="12dp"/>

                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="#E86FA0" android:layout_marginEnd="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cao" android:textSize="10sp" android:textColor="#7D8BB7"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Quy Luật &amp; Tác Nhân"
                        android:textColor="#313866"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Tác nhân ảnh hưởng nhiều nhất:"
                        android:textColor="#7D8BB7"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:id="@+id/layoutFactors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F5F5F5"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Phân tích khung giờ:"
                        android:textColor="#7D8BB7"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/txtTimePattern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_medium"
                        android:text="• Cảm xúc tích cực thường xuất hiện vào Buổi sáng (08:00 - 10:00).\n• Cảm xúc căng thẳng thường tăng cao vào Buổi chiều muộn (15:00 - 17:00)."
                        android:textColor="#313866"
                        android:lineSpacingExtra="4sp"
                        android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Thống Kê Chuỗi"
                        android:textColor="#313866"
                        android:textSize="15sp"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_fire"
                                app:tint="#FF8A65"/>
                            <TextView
                                android:id="@+id/txtCurrentStreak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/quicksand_bold"
                                android:text="7 ngày"
                                android:textColor="#313866"
                                android:textSize="16sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/quicksand_medium"
                                android:text="Chuỗi hiện tại"
                                android:textColor="#7D8BB7"
                                android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_star"
                                app:tint="#FFB300"/>
                            <TextView
                                android:id="@+id/txtMaxStreak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/quicksand_bold"
                                android:text="15 ngày"
                                android:textColor="#313866"
                                android:textSize="16sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/quicksand_medium"
                                android:text="Chuỗi kỷ lục"
                                android:textColor="#7D8BB7"
                                android:textSize="11sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_schedule"
                                app:tint="#00BFA5"/>
                            <TextView
                                android:id="@+id/txtTotalDays"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/quicksand_bold"
                                android:text="42 ngày"
                                android:textColor="#313866"
                                android:textSize="16sp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/quicksand_medium"
                                android:text="Tổng check-in"
                                android:textColor="#7D8BB7"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/quicksand_bold"
                            android:text="Nhật Ký Gần Đây"
                            android:textColor="#313866"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/btnGoToJournal"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_heal_diary"
                            app:tint="#9C27B0"
                            android:contentDescription="Mở trang nhật ký" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/layoutJournalLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand_bold"
                        android:text="Khuyến Nghị Chữa Lành"
                        android:textColor="#313866"
                        android:textSize="15sp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/layoutRecommendations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>