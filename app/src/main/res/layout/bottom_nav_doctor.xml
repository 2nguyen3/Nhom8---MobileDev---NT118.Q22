<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutBottomNavDoctor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    android:layout_marginEnd="18dp"
    android:layout_marginBottom="10dp"
    android:alpha="0.98"
    android:background="@drawable/bg_doctor_bottom_nav"
    android:elevation="18dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="10dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <!-- Tổng quan -->
    <LinearLayout
        android:id="@+id/navDoctorOverview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="7dp"
        android:paddingEnd="4dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/navDoctorOverviewIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="overview"
            android:src="@drawable/ic_nav_doctor_overview" />

        <TextView
            android:id="@+id/navDoctorOverviewText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Tổng quan"
            android:textColor="#B5BFD1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Lịch hẹn -->
    <LinearLayout
        android:id="@+id/navDoctorAppointments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="7dp"
        android:paddingEnd="4dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/navDoctorAppointmentsIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="appointments"
            android:src="@drawable/ic_nav_doctor_appointments" />

        <TextView
            android:id="@+id/navDoctorAppointmentsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Lịch hẹn"
            android:textColor="#B5BFD1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bệnh nhân -->
    <LinearLayout
        android:id="@+id/navDoctorPatients"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="7dp"
        android:paddingEnd="4dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/navDoctorPatientsIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="patients"
            android:src="@drawable/ic_nav_doctor_patients" />

        <TextView
            android:id="@+id/navDoctorPatientsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Bệnh nhân"
            android:textColor="#B5BFD1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tin nhắn -->
    <LinearLayout
        android:id="@+id/navDoctorMessages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="7dp"
        android:paddingEnd="4dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/navDoctorMessagesIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="messages"
            android:src="@drawable/ic_nav_doctor_messages" />

        <TextView
            android:id="@+id/navDoctorMessagesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Tin nhắn"
            android:textColor="#B5BFD1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cá nhân -->
    <LinearLayout
        android:id="@+id/navDoctorProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="7dp"
        android:paddingEnd="4dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/navDoctorProfileIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="profile"
            android:src="@drawable/ic_nav_doctor_profile" />

        <TextView
            android:id="@+id/navDoctorProfileText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Cá nhân"
            android:textColor="#B5BFD1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
