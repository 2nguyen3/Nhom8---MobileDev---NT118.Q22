<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/bg_home_notification_popup"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/quicksand_bold"
        android:text="Người tin cậy"
        android:textColor="#313866"
        android:textSize="21sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/quicksand_medium"
        android:lineSpacingExtra="4dp"
        android:text="Nhập số điện thoại người thân hoặc bạn bè mà bạn muốn liên hệ khi cần hỗ trợ."
        android:textColor="#7D8BB7"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/edtTrustedPhone"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_soft"
        android:fontFamily="@font/quicksand_medium"
        android:hint="Ví dụ: 0901234567"
        android:inputType="phone"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#313866"
        android:textColorHint="#AAB4CF"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveTrustedPhone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/quicksand_bold"
        android:text="Lưu số liên hệ"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="#00BFA5"
        app:cornerRadius="28dp"
        app:elevation="0dp" />

    <TextView
        android:id="@+id/btnCancelTrustedPhone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/quicksand_bold"
        android:gravity="center"
        android:text="Hủy"
        android:textColor="#9AA8C7"
        android:textSize="14sp" />

</LinearLayout>