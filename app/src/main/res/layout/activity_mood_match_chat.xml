<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/moodMatchChatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FF">

    <LinearLayout
        android:id="@+id/layoutTopArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#EBFFFFFF"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="52dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/layoutTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnBackMoodChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_mood_chat_more_stub">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="back"
                    android:src="@drawable/ic_back"
                    app:tint="#9EAFC2" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_mood_chat_avatar_stub">

                    <TextView
                        android:id="@+id/txtAvatarEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🦊"
                        android:textSize="24sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtChatName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cáo nhỏ hồng"
                        android:textColor="#2D3A5E"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💙"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtChatMood"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Đang buồn"
                            android:textColor="#6B9EE8"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="· Ẩn danh"
                            android:textColor="#C0BACA"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnMoreMoodChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_mood_chat_more_stub">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⋮"
                    android:textColor="#9EAFC2"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutSafetyBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_mood_chat_safe_banner_stub"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:contentDescription="safety"
                android:src="@drawable/ic_safety_shield" />

            <TextView
                android:id="@+id/txtSafetyBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Cuộc trò chuyện ẩn danh &amp; bảo mật hoàn toàn"
                android:textColor="#4BBBAD"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutChatArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomArea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopArea">

        <LinearLayout
            android:id="@+id/layoutSystemCardWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/layoutSystemCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mood_chat_system_card_stub"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/txtSystemCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Heami đã kết nối bạn với một người có cùng nhịp cảm xúc hôm nay."
                    android:textColor="#5A8A8A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMoodChatMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutMoodChatEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💌"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Chưa có tin nhắn nào"
                    android:textColor="#2D1B47"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Hãy bắt đầu bằng một lời chào nhẹ nhàng nhé"
                    android:textColor="#9A8AAA"
                    android:textSize="12sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressMoodChatLoading"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBottomArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#EBFFFFFF"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layoutComposerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtMoodChatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_mood_chat_input_stub"
                android:gravity="center_vertical"
                android:hint="Chia sẻ nhẹ nhàng..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:scrollHorizontally="false"
                android:textColor="#3A2A4A"
                android:textColorHint="#803A2949"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/btnSendMoodChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_mood_chat_send_inactive"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgSendMoodChat"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="send"
                    android:src="@drawable/ic_send_comment"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutReactionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReactionHug"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_mood_chat_reaction_stub"
                android:gravity="center"
                android:text="🤗"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnReactionHeart"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mood_chat_reaction_stub"
                android:gravity="center"
                android:text="💙"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnReactionFlower"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mood_chat_reaction_stub"
                android:gravity="center"
                android:text="🌸"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnReactionSparkle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mood_chat_reaction_stub"
                android:gravity="center"
                android:text="✨"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnReactionPray"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mood_chat_reaction_stub"
                android:gravity="center"
                android:text="🙏"
                android:textSize="18sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEndMoodChat"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_mood_chat_end_stub"
                android:backgroundTint="@null"
                android:minHeight="38dp"
                android:minWidth="88dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="× Kết thúc"
                android:textAllCaps="false"
                android:textColor="#FF6B6B"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>