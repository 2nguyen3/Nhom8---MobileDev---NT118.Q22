<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_community_chat_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_community_chat_avatar_ring_blue" />

        <TextView
            android:id="@+id/txtChatRoomAvatarEmoji"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_community_chat_avatar_blue"
            android:gravity="center"
            android:text="🌸"
            android:textSize="28sp" />

        <View
            android:id="@+id/viewChatRoomOnlineDot"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="3dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_community_chat_online_dot"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtChatRoomPartnerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Người bạn ẩn danh"
                android:textColor="#2D1B47"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChatRoomTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vừa xong"
                android:textColor="#E8507A"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtChatRoomLastMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Bạn vừa được kết nối qua Mood Match"
                android:textColor="#4A3A5A"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChatRoomPinBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="📌"
                android:textColor="#E8507A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtChatRoomMuteBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="🔕"
                android:textColor="#8F7AA8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtChatRoomArchivedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="🗂"
                android:textColor="#8F7AA8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtChatRoomUnreadBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_community_chat_unread_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>