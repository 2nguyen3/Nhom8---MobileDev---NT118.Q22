<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#14009688" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <stroke
                android:width="1.5dp"
                android:color="#73009688" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
