<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <solid android:color="#0DFFFFFF" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#8CFFFFFF"
                android:centerColor="#7CFAFBFF"
                android:endColor="#8CF7F1FF" />
            <stroke
                android:width="1.5dp"
                android:color="#B3FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>

</layer-list>
